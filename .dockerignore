# Keep the Docker build context small: no checkpoints, data, or VCS noise.
.git
.gitignore
.github
.claude

# Trained artifacts — mounted in at runtime via -v, never baked into image.
checkpoints
*.pt
*.safetensors
*.bin

# Data dirs (memmap packed data, raw corpus, caches).
packed
sft_packed
grpo_packed
dpo_packed
data/*.bin
data/*.json
webscrapped_dataset_curator_AI_MCP

# Python build/cache noise.
__pycache__
*.pyc
.pytest_cache
*.egg-info
.venv
venv

# Logs / scratch.
logs
*.log

# Next.js build outputs — produced by the Dockerfile inside the image,
# never copy them in (different base image = different node_modules ABI).
.next
.next/
**/.next
UI/.next
UI_lite/.next
UI_RenderRouter/.next

# Runtime secrets shipped by the user as ./secrets/*.env — never bake them
# into an image.
secrets
.env
.env.local
.env.*.local
*.env
