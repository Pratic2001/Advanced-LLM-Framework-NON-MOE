# =============================================================================
# UI_RenderRouter container — Next.js app that renders the landing page +
# iframe-mounts /heavy and /lite from the sibling UI container.
#
# Standalone Next output (`output: "standalone"`) gives us a tiny node_modules
# that runs without `npm install` at container start.
#
# The two URL vars get baked into client JS at build time — these are the
# public Tailscale URLs the user types in the browser. CI substitutes
# ${PUBLIC_HOSTNAME} in from a GH Secret.
# =============================================================================

# Stage 1 — deps
FROM node:22-alpine AS deps
WORKDIR /app
COPY UI_RenderRouter/package.json UI_RenderRouter/package-lock.json ./
RUN npm ci --include=dev

# Stage 2 — build
FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY UI_RenderRouter/. .

ARG NEXT_PUBLIC_HEAVY_UI_URL
ARG NEXT_PUBLIC_LITE_UI_URL
ENV NEXT_PUBLIC_HEAVY_UI_URL=${NEXT_PUBLIC_HEAVY_UI_URL} \
    NEXT_PUBLIC_LITE_UI_URL=${NEXT_PUBLIC_LITE_UI_URL} \
    NEXT_TELEMETRY_DISABLED=1

RUN npm run build

# Stage 3 — runner
FROM node:22-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    PORT=3002 \
    HOSTNAME=0.0.0.0 \
    NEXT_TELEMETRY_DISABLED=1

# Non-root runtime user.
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Standalone server + static assets. .next/standalone/server.js is what
# `next start -p 3002` would have run; we point CMD at it directly.
#
# UI_RenderRouter has no /public directory, so we don't COPY it — the empty
# ./public we mkdir below satisfies Next's standalone static-server probe.
RUN mkdir -p ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static    ./.next/static

USER nextjs
EXPOSE 3002

CMD ["node", "server.js"]