# ---------------------------------------------------------------------------
# Containerized deployment (docker compose)
# ---------------------------------------------------------------------------
# When the stack runs in Docker (recommended), the values below are
# generated by the release workflow from GH Secrets and dropped into
# ./secrets/ui.env next to docker-compose.yml. Do not edit those files
# by hand — they get regenerated every time a v* tag is pushed. For local
# dev, copy this file to .env.local and edit there instead.

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llm_training_ui"

# NextAuth (Auth.js v5)
# AUTH_SECRET is required for JWT signing — generate with: openssl rand -base64 32
# This is the value Auth.js itself uses (automatically, via lib/auth.ts) to
# sign and encrypt your session cookie.
AUTH_SECRET="your-secret-key-change-in-production"

# NEXTAUTH_SECRET is ALSO required — separately from AUTH_SECRET — because
# lib/env.ts validates it as its own required env var, and lib/ws-manager.ts
# uses it (not AUTH_SECRET) to decode/verify the session cookie when
# authenticating the interactive-shell WebSocket connection (/api/ws).
#
# IMPORTANT: set this to the EXACT SAME value as AUTH_SECRET above. If they
# differ, normal page/API auth will keep working (it only uses AUTH_SECRET),
# but the interactive shell will silently fail every time — the WebSocket
# will open, immediately fail to decode the cookie, and close before the
# shell ever starts, showing "Connection closed before shell opened" in the
# terminal UI.
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# AUTH_URL sets the canonical app origin. Optional — leave unset and Auth.js
# will infer it from the request when trustHost is enabled.
# AUTH_URL="http://localhost:3000"

# NEXTAUTH_URL is REQUIRED (lib/env.ts has no default for it) — set it to the
# same origin as AUTH_URL above. For local development this is:
NEXTAUTH_URL="http://localhost:3000"

# AUTH_TRUST_HOST must be true when running on localhost or any custom host
# (not a known Vercel/Netlify/etc. platform). Without this, /api/auth/*
# throws `UntrustedHost: Host must be trusted`. Defaults to true in this UI.
AUTH_TRUST_HOST="true"

# ----------------------------------------------------------------------
# Exposing the UI publicly (Tailscale Funnel, Cloudflare Tunnel, reverse proxy)
# ----------------------------------------------------------------------
# When the UI is reached via a public hostname (e.g. https://your-app.ts.net
# via `tailscale funnel`, or https://ui.yourdomain.com via Cloudflare Tunnel)
# Auth.js needs to know the canonical origin so it can:
#   1. Scope session cookies to the public host (otherwise sign-in loops).
#   2. Build correct OAuth callback / sign-in redirect URLs.
#   3. Accept the request under its UntrustedHost check.
#
# Set BOTH of these to your PUBLIC URL (the one users type in the browser),
# not http://localhost:3000. Leave them at the localhost values above if
# you're only accessing the UI locally.
#
# Examples:
#   Tailscale Funnel:
#     AUTH_URL=https://pratic-battleaxb450mkm2.tail5e5151.ts.net
#     NEXTAUTH_URL=https://pratic-battleaxb450mkm2.tail5e5151.ts.net
#   Cloudflare Tunnel:
#     AUTH_URL=https://ui.yourdomain.com
#     NEXTAUTH_URL=https://ui.yourdomain.com
#   Custom domain behind nginx/Caddy:
#     AUTH_URL=https://llmforge.example.com
#     NEXTAUTH_URL=https://llmforge.example.com
#
# IMPORTANT: After changing these, restart Next.js fully and clear cookies
# for the old host in your browser — stale cookies are the #1 cause of the
# "click sign-in, page reloads" loop.
# AUTH_URL="https://your-public-hostname"
# NEXTAUTH_URL="https://your-public-hostname"

# ----------------------------------------------------------------------
# Serving behind a base path (Tailscale funnel path mounts: /heavy)
# ----------------------------------------------------------------------
# When this UI is mounted at a path on a single funneled port (e.g.
# https://host.ts.net/heavy -> this app via `tailscale serve --set-path=/heavy`),
# Next.js must render every URL under that path. basePath is read in
# next.config.mjs from NEXT_PUBLIC_BASE_PATH (inlined at BUILD time, so
# rebuild after changing it), and the same var drives lib/base-path.ts so the
# hand-written fetch/WebSocket/EventSource URLs in the client line up.
# For local dev against the dev server, set this to "" or leave it unset.
NEXT_PUBLIC_BASE_PATH="/heavy"

# next-auth/react derives its client basePath from the PATH of
# process.env.NEXTAUTH_URL, but Next only inlines NEXT_PUBLIC_* into browser
# bundles. lib/auth-env.ts materializes NEXTAUTH_URL from this copy BEFORE
# next-auth evaluates, so sign-in/sign-out and the session fetch hit
# /heavy/api/auth/* instead of silently falling back to /api/auth (which only
# matches at the root). The path MUST include /api/auth on the end — the
# Auth.js client treats the URL's path as the FULL auth base, not the app's
# basePath. With it set to just /heavy, the client builds
# /heavy/callback/credentials (404) and getProviders() falls back to
# window.location.href = "/heavy/error".
NEXT_PUBLIC_NEXTAUTH_URL="https://your-host.ts.net/heavy/api/auth"

# Server
# HOSTNAME="0.0.0.0"
# PORT=3000

# SSH Key Encryption (32 hex chars for AES-256-GCM)
SSH_KEY_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Optional: Default repo root path for training scripts
REPO_ROOT="../"

# Email Notifications (for job failure alerts)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="LLMForge <noreply@yourdomain.com>"
# NOTIFICATION_EMAIL="you@example.com"