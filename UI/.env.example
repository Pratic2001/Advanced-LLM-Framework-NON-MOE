# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/llm_training_ui"

# NextAuth (Auth.js v5)
# AUTH_SECRET is required for JWT signing — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-key-change-in-production"

# AUTH_URL sets the canonical app origin. Optional — leave unset and Auth.js
# will infer it from the request when trustHost is enabled.
# AUTH_URL="http://localhost:3000"

# AUTH_TRUST_HOST must be true when running on localhost or any custom host
# (not a known Vercel/Netlify/etc. platform). Without this, /api/auth/*
# throws `UntrustedHost: Host must be trusted`. Defaults to true in this UI.
AUTH_TRUST_HOST="true"

# Server
# HOSTNAME="0.0.0.0"
# PORT=3000

# SSH Key Encryption (32 hex chars for AES-256-GCM)
SSH_KEY_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

# Optional: Default repo root path for training scripts
REPO_ROOT="../"

# Email Notifications (for job failure alerts)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-app-password"
# SMTP_FROM="LLMForge <noreply@yourdomain.com>"
# NOTIFICATION_EMAIL="you@example.com"